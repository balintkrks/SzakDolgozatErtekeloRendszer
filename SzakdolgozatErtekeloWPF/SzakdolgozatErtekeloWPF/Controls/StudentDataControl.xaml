<UserControl x:Class="SzakdolgozatErtekeloWPF.Controls.StudentDataControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid Margin="0,20">
        <Border CornerRadius="12" Background="White">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.05" BlurRadius="20" ShadowDepth="4"/>
            </Border.Effect>
        </Border>
        
        <Border Padding="25,20"
                CornerRadius="12"
                BorderThickness="2"
                BorderBrush="{DynamicResource PrimaryBrush}"
                Background="White">

            <StackPanel>

                <TextBlock
                    x:Name="TitleText"
                    FontSize="22"
                    FontWeight="Bold"
                    Margin="0,0,0,20"/>

                <Grid Margin="0,10,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="15" />
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="15" />
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="15" />
                        <ColumnDefinition Width="1.5*" />
                    </Grid.ColumnDefinitions>

                <!-- Név -->
                <StackPanel Grid.Column="0">

                    <TextBlock
                        x:Name="NameLabel"
                        Margin="0,0,0,5"/>

                    <TextBox
                        x:Name="NevTextBox"
                        MinHeight="35"/>

                </StackPanel>

                <!-- Neptun -->
                <StackPanel Grid.Column="2">

                    <TextBlock
                        x:Name="NeptunLabel"
                        Margin="0,0,0,5"/>

                    <TextBox
                        x:Name="NeptunTextBox"
                        MinHeight="35"
                        MaxLength="6"/>

                </StackPanel>

                <!-- Szak -->
                <StackPanel Grid.Column="4">

                    <TextBlock
                        x:Name="SzakLabel"
                        Margin="0,0,0,5"/>

                    <ComboBox
                        x:Name="SzakComboBox"
                        MinHeight="35"/>

                </StackPanel>

                <!-- Cím -->
                <StackPanel Grid.Column="6">

                    <TextBlock
                        x:Name="CimLabel"
                        Margin="0,0,0,5"/>

                    <TextBox
                        x:Name="CimTextBox"
                        MinHeight="35"/>

                </StackPanel>

            </Grid>

        </StackPanel>

        </Border>
    </Grid>

</UserControl>