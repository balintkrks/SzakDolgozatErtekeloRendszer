<UserControl x:Class="SzakdolgozatErtekeloWPF.Controls.StudentDataControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Border Margin="0,20"
            Padding="10"
            CornerRadius="10"
            BorderThickness="1"
            BorderBrush="#DDDDDD"
            Background="White"
            Height="213">

        <StackPanel>

            <TextBlock
                x:Name="TitleText"
                FontSize="22"
                FontWeight="Bold"
                Margin="0,0,0,20"/>

            <Grid Margin="0,10,0,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="15" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="15" />
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="15" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>

                <!-- Név -->
                <StackPanel Grid.Column="0">

                    <TextBlock
                        x:Name="NameLabel"
                        Margin="0,0,0,5"/>

                    <TextBox
                        x:Name="NevTextBox"
                        Height="35"/>

                </StackPanel>

                <!-- Neptun -->
                <StackPanel Grid.Column="2">

                    <TextBlock
                        x:Name="NeptunLabel"
                        Margin="0,0,0,5"/>

                    <TextBox
                        x:Name="NeptunTextBox"
                        Height="35"
                        MaxLength="6"/>

                </StackPanel>

                <!-- Szak -->
                <StackPanel Grid.Column="4">

                    <TextBlock
                        x:Name="SzakLabel"
                        Margin="0,0,0,5"/>

                    <ComboBox
                        x:Name="SzakComboBox"
                        Height="35"/>

                </StackPanel>

                <!-- Cím -->
                <StackPanel Grid.Column="6">

                    <TextBlock
                        x:Name="CimLabel"
                        Margin="0,0,0,5"/>

                    <TextBox
                        x:Name="CimTextBox"
                        Height="35"/>

                </StackPanel>

            </Grid>

        </StackPanel>

    </Border>

</UserControl>