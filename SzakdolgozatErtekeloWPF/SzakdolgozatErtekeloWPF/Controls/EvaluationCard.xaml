<UserControl x:Class="SzakdolgozatErtekeloWPF.Controls.EvaluationCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="10">
        <Border CornerRadius="12" Background="White">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.05" BlurRadius="20" ShadowDepth="4"/>
            </Border.Effect>
        </Border>
        
        <Border Padding="25,20"
                CornerRadius="12"
                BorderBrush="{DynamicResource PrimaryBrush}"
                BorderThickness="2"
                Background="White">

            <StackPanel>

            <!-- Sorszám + Cím -->

            <StackPanel Orientation="Horizontal">

                <TextBlock
                    x:Name="NumberText"
                    Text="1."
                    FontSize="24"
                    FontWeight="Bold"
                    Foreground="{DynamicResource PrimaryBrush}"
                    Margin="0,0,10,0"/>

                <TextBlock
                    x:Name="TitleText"
                    FontSize="18"
                    FontWeight="Bold"
                    TextWrapping="Wrap"
                    MaxWidth="500"
                    VerticalAlignment="Center"/>

            </StackPanel>

            

            <StackPanel Margin="10,10,10,0">

                <TextBlock
                    x:Name="ZeroText"
                    Margin="0,2"/>

                <TextBlock
                    x:Name="OneTwoText"
                    Margin="0,2"
                />

                <TextBlock
                    x:Name="ThreeFourText"
                    Margin="0,2"
                />

                <TextBlock
                    x:Name="FiveText"
                    Margin="0,2"
                />

            </StackPanel>

            

            <Slider
                x:Name="PointSlider"
                Margin="0,20,0,0"
                Minimum="0"
                Maximum="5"
                TickFrequency="0.5"
                IsSnapToTickEnabled="True"
                IsMoveToPointEnabled="True"
                Foreground="{DynamicResource PrimaryBrush}"
                TickPlacement="BottomRight"
                ValueChanged="PointSlider_ValueChanged"/>

            <!-- Skála -->

            <Grid Margin="9,2,9,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="0" HorizontalAlignment="Left" FontSize="11" Foreground="#888"/>
                <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Text="0.5" HorizontalAlignment="Center" FontSize="11" Foreground="#888"/>
                <TextBlock Grid.Column="1" Grid.ColumnSpan="2" Text="1" HorizontalAlignment="Center" FontSize="11" Foreground="#888"/>
                <TextBlock Grid.Column="2" Grid.ColumnSpan="2" Text="1.5" HorizontalAlignment="Center" FontSize="11" Foreground="#888"/>
                <TextBlock Grid.Column="3" Grid.ColumnSpan="2" Text="2" HorizontalAlignment="Center" FontSize="11" Foreground="#888"/>
                <TextBlock Grid.Column="4" Grid.ColumnSpan="2" Text="2.5" HorizontalAlignment="Center" FontSize="11" Foreground="#888"/>
                <TextBlock Grid.Column="5" Grid.ColumnSpan="2" Text="3" HorizontalAlignment="Center" FontSize="11" Foreground="#888"/>
                <TextBlock Grid.Column="6" Grid.ColumnSpan="2" Text="3.5" HorizontalAlignment="Center" FontSize="11" Foreground="#888"/>
                <TextBlock Grid.Column="7" Grid.ColumnSpan="2" Text="4" HorizontalAlignment="Center" FontSize="11" Foreground="#888"/>
                <TextBlock Grid.Column="8" Grid.ColumnSpan="2" Text="4.5" HorizontalAlignment="Center" FontSize="11" Foreground="#888"/>
                <TextBlock Grid.Column="9" Text="5" HorizontalAlignment="Right" FontSize="11" Foreground="#888"/>
            </Grid>

            <!-- Pont -->

            <TextBlock
                Margin="0,10,0,10"
                FontWeight="Bold">

                <Run x:Name="PointLabelRun"/>

                <Run
                    x:Name="PointText"
                    Text="0"/>

            </TextBlock>

            

            <TextBlock
                x:Name="CommentLabelText"
                Margin="0,5"/>

            <TextBox
                x:Name="CommentTextBox"
                Height="80"
                AcceptsReturn="True"
                TextWrapping="Wrap"/>

        </StackPanel>

        </Border>
    </Grid>

</UserControl>