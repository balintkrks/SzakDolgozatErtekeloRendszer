<UserControl x:Class="SzakdolgozatErtekeloWPF.Controls.EvaluationCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        Margin="10"
        Padding="20"
        CornerRadius="10"
        BorderBrush="#DDDDDD"
        BorderThickness="1"
        Background="White">

        <StackPanel>

            <!-- Sorszám + Cím -->

            <StackPanel Orientation="Horizontal">

                <TextBlock
                    x:Name="NumberText"
                    Text="1."
                    FontSize="24"
                    FontWeight="Bold"
                    Margin="0,0,10,0"/>

                <TextBlock
                    x:Name="TitleText"
                    FontSize="17"
                    FontWeight="Bold"
                    TextWrapping="Wrap"
                    MaxWidth="500"
                    VerticalAlignment="Center"/>

            </StackPanel>

            

            <StackPanel Margin="10,0">

                <TextBlock
                    x:Name="ZeroText"
                    Margin="0,2"/>

                <TextBlock
                    x:Name="OneTwoText"
                    Margin="0,2"
                />

                <TextBlock
                    x:Name="ThreeFourText"
                    Margin="0,2"
                />

                <TextBlock
                    x:Name="FiveText"
                    Margin="0,2"
                />

            </StackPanel>

            

            <Slider
                x:Name="PointSlider"
                Margin="0,20,0,0"
                Minimum="0"
                Maximum="5"
                TickFrequency="0.5"
                IsSnapToTickEnabled="True"
                ValueChanged="PointSlider_ValueChanged"/>

            <!-- Skála -->

            <Grid Margin="0,5,0,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Text="0"
                    HorizontalAlignment="Left"/>

                <TextBlock
                    Grid.Column="1"
                    Text="5"
                    HorizontalAlignment="Right"/>

            </Grid>

            <!-- Pont -->

            <TextBlock
                Margin="0,10,0,10"
                FontWeight="Bold">

                <Run x:Name="PointLabelRun"/>

                <Run
                    x:Name="PointText"
                    Text="0"/>

            </TextBlock>

            

            <TextBlock
                x:Name="CommentLabelText"
                Margin="0,5"/>

            <TextBox
                x:Name="CommentTextBox"
                Height="80"
                AcceptsReturn="True"
                TextWrapping="Wrap"/>

        </StackPanel>

    </Border>

</UserControl>