<UserControl x:Class="SzakdolgozatErtekeloWPF.Controls.SummaryControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Margin="20,10,20,20">

        <!-- Szöveges értékelés -->
        <TextBlock
            x:Name="SzovegesErtekelesCimText"
            FontSize="18"
            FontWeight="Bold"
            Margin="0,20,0,8"
            Foreground="#222222"/>

        <Border BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="8">
            <TextBox
                x:Name="RovidErtekelesBox"
                Height="100"
                AcceptsReturn="True"
                TextWrapping="Wrap"
                Padding="10"
                BorderThickness="0"
                VerticalScrollBarVisibility="Auto"/>
        </Border>

        <!-- Bírálói javaslat -->
        <TextBlock
            x:Name="BiraloiJavaslatkCimText"
            FontSize="18"
            FontWeight="Bold"
            Margin="0,30,0,8"
            Foreground="#222222"/>

        <Border BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="8">
            <TextBox
                x:Name="BitraloiJavaslat"
                Height="100"
                AcceptsReturn="True"
                TextWrapping="Wrap"
                Padding="10"
                BorderThickness="0"
                VerticalScrollBarVisibility="Auto"/>
        </Border>

        <!-- Kérdések -->
        <StackPanel Orientation="Horizontal" Margin="0,30,0,8">
            <TextBlock
                x:Name="KerdesekCimText"
                FontSize="18"
                FontWeight="Bold"
                Foreground="#222222"/>
            <TextBlock
                Text=" *"
                FontSize="18"
                FontWeight="Bold"
                Foreground="#E03F3F"/>
        </StackPanel>

        <StackPanel
            x:Name="KerdesekLista"
            Margin="0,0,0,10"/>

        <Button
            x:Name="UjKerdesGomb"
            Content="+ Új kérdés hozzáadása"
            HorizontalAlignment="Left"
            Style="{StaticResource DashedButton}"
            Click="UjKerdesGomb_Click"/>

        <!-- Elválasztó -->
        <Separator Margin="0,30,0,0" Background="#E8E8E8"/>

    </StackPanel>

</UserControl>
