<UserControl x:Class="SzakdolgozatErtekeloWPF.Controls.SwitchPanelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel HorizontalAlignment="Center"
                Orientation="Horizontal"
                Margin="0,20">

        
        <GroupBox
                  Margin="0,0,30,0">

            <StackPanel Orientation="Horizontal"
                        Margin="10,5">

                <RadioButton x:Name="AltalanosRadio"
                             Content="Általános"
                             GroupName="Mode"
                             IsChecked="True"
                             Margin="10,0"/>

                <RadioButton x:Name="TudomanyosRadio"
                             Content="Tudományos"
                             GroupName="Mode"
                             Margin="10,0"/>

            </StackPanel>

        </GroupBox>

        
        <GroupBox>

            <StackPanel Orientation="Horizontal"
                        Margin="10,5">

                <RadioButton x:Name="MagyarRadio"
                             Content="Magyar"
                             GroupName="Language"
                             IsChecked="True"
                             Margin="10,0"/>

                <RadioButton x:Name="AngolRadio"
                             Content="Angol"
                             GroupName="Language"
                             Margin="10,0"/>

            </StackPanel>

        </GroupBox>

    </StackPanel>

</UserControl>
